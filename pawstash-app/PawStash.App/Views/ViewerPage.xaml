<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PawStash.ViewModels"
             x:Class="PawStash.Views.ViewerPage"
             x:DataType="vm:ViewerViewModel"
             Title="{Binding Name}">

    <Grid>
        <Image Source="{Binding Photo}" Aspect="AspectFit" IsVisible="{Binding HasPhoto}" />
        <ScrollView IsVisible="{Binding HasText}">
            <Label Text="{Binding Text}" FontSize="16" Padding="16" />
        </ScrollView>
        <Label Text="{Binding Error}" IsVisible="{Binding HasError}" TextColor="Red" Margin="16" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
