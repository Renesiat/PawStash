<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PawStash.ViewModels"
             x:Class="PawStash.Views.ItemPage"
             x:DataType="vm:ItemViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">
            <VerticalStackLayout IsVisible="{Binding IsReady}" Spacing="8">
                <VerticalStackLayout IsVisible="{Binding IsLink}" Spacing="4">
                    <Label Text="Адреса" />
                    <Entry Text="{Binding LinkUrl}" Placeholder="https://" Keyboard="Url" IsSpellCheckEnabled="False" />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsNote}" Spacing="4">
                    <Label Text="Текст" />
                    <Editor Text="{Binding NoteText}" AutoSize="TextChanges" MinimumHeightRequest="120" />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsUploadedFile}" Spacing="4">
                    <Label Text="Файл" />
                    <Label Text="{Binding FileInfo}" TextColor="#8E8E93" />
                    <Button Text="Замінити файл" Command="{Binding PickFileCommand}" HorizontalOptions="Start" />
                </VerticalStackLayout>

                <Label Text="Назва" />
                <Entry Text="{Binding Name}" Placeholder="{Binding NamePlaceholder}" />

                <Label Text="Опис" />
                <Editor Text="{Binding Description}" AutoSize="TextChanges" />

                <Label Text="Обкладинка" />
                <Border WidthRequest="96"
                        HeightRequest="96"
                        HorizontalOptions="Start"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        IsVisible="{Binding HasCoverImage}">
                    <Image Source="{Binding CoverImage}" Aspect="AspectFill" WidthRequest="96" HeightRequest="96" />
                </Border>
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Вибрати з галереї" Command="{Binding PickCoverImageCommand}" />
                    <Button Text="Прибрати" Command="{Binding RemoveCoverImageCommand}" IsVisible="{Binding HasCoverImage}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Label Text="{Binding Error}" IsVisible="{Binding HasError}" TextColor="Red" />
            <Button Text="Зберегти" Command="{Binding SaveCommand}" IsVisible="{Binding IsReady}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
